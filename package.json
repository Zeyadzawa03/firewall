{
  "name": "sentryfw",
  "version": "2.0.0",
  "description": "SentryFW — firewall management console with REST API, operator GUI, CLI, traffic monitoring and an embedded Fortinet knowledge base.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "fwctl": "./bin/fwctl.js"
  },
  "scripts": {
    "start": "node bin/fwctl.js serve",
    "serve": "node bin/fwctl.js serve",
    "cli": "node bin/fwctl.js",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/**/*.test.js\"",
    "test:all": "node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "keywords": [
    "firewall",
    "security",
    "netsecurity",
    "iptables",
    "nftables",
    "monitoring",
    "siem"
  ],
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {}
}
