{
  "$comment": "SentryFW default configuration. Do not edit this file for local changes - it is the shipped baseline. Runtime overrides are written to data/config.json by the GUI/CLI, and environment variables (FWCTL_*) win over both.",

  "server": {
    "host": "127.0.0.1",
    "port": 8787,
    "publicDir": "public",
    "kbDir": ".",
    "requireAuth": true,
    "sessionTtlMinutes": 120,
    "trustProxy": false,
    "maxBodyBytes": 262144
  },

  "firewall": {
    "provider": "simulated",
    "applyToOS": false,
    "defaultPolicy": {
      "inbound": "deny",
      "outbound": "allow"
    },
    "rulePrefix": "SentryFW",
    "windows": {
      "profiles": ["Domain", "Private", "Public"],
      "policyStore": "PersistentStore"
    },
    "linux": {
      "backend": "auto",
      "table": "filter",
      "chainIn": "INPUT",
      "chainOut": "OUTPUT"
    }
  },

  "monitoring": {
    "enabled": true,
    "intervalSeconds": 10,
    "maxTrackedConnections": 4000,
    "sampleProcessNames": true,
    "retainSamples": 180
  },

  "detection": {
    "enabled": true,
    "portScan": {
      "enabled": true,
      "distinctPorts": 12,
      "windowSeconds": 60
    },
    "connectionFlood": {
      "enabled": true,
      "connections": 60,
      "windowSeconds": 60
    },
    "deniedBurst": {
      "enabled": true,
      "denies": 10,
      "windowSeconds": 120
    },
    "sensitivePorts": [22, 23, 135, 139, 445, 1433, 3306, 3389, 5432, 5900, 6379, 9200, 27017],
    "beaconing": {
      "enabled": true,
      "minSamples": 5,
      "jitterToleranceSeconds": 3
    },
    "autoBlockOnScan": false
  },

  "logging": {
    "level": "info",
    "maxFileBytes": 5242880,
    "maxFiles": 5,
    "console": true,
    "logAllowed": true,
    "logDenied": true
  },

  "security": {
    "pbkdf2Iterations": 210000,
    "loginMaxAttempts": 5,
    "loginLockoutSeconds": 300,
    "apiRateLimit": {
      "windowSeconds": 60,
      "maxRequests": 600
    },
    "requireConfirmForDestructive": true
  },

  "blocklist": {
    "enabled": true,
    "evaluateBeforeRules": true,
    "defaultTtlHours": 0
  }
}
